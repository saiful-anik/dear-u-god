{
  "name": "dear-u-api",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "wrangler dev",
    "dev:frontend": "npm run dev --workspace frontend",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.97.0"
  }
}
